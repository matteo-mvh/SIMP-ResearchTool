
# Ignore everything in the root directory
/*

# Core source code
!/app/
!/model/
!/scripts/

# Documentation and tests
!/docs/
!/tests/
!/README.md

# Dependencies
!/requirements.txt

# Application and worker startup
!/start_app.py
!/start_worker.py
!/Start_SIMPCenter.bat
!/Start_Worker_Console.bat

# Debugging information
!/debug/

# Git configuration
!/.gitignore

# Python-generated files
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
.venv/
.pytest_cache/
*.debugtmp

# Runtime and temporary files
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.lock
*.log

# Allow debug logs
!/debug/**/*.log

# Credentials
.env
.env.*
*.pem
*.key
